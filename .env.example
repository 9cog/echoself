# Deep Tree Echo - Environment Variables Example
# Copy to `.env` and fill with your project credentials

# Supabase configuration (required)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY

# OpenAI (optional but enables embeddings and chat)
OPENAI_API_KEY=sk-...

# Server
PORT=3000
NODE_ENV=development

# Local ech0-mem0 / mech0 (self-hosted memory; cloud Mem0 is not required)
MECH0_URL=http://127.0.0.1:8765
MECH0_HOST=127.0.0.1
MECH0_PORT=8765
MECH0_DATA_DIR=.mech0/data