# Deep Tree Echo - Environment Variables Example
# Copy to `.env` and fill with your project credentials

# Supabase configuration (required)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY

# OpenAI (optional but enables embeddings and chat)
OPENAI_API_KEY=sk-...

# Server
PORT=3000
NODE_ENV=development

# Local ech0-mem0 / mech0 (self-hosted memory; cloud Mem0 is not required)
MECH0_URL=http://127.0.0.1:8765
MECH0_HOST=127.0.0.1
MECH0_PORT=8765
MECH0_DATA_DIR=.mech0/data

# Autognosis (optional path override; remember stays off unless asked)
# AUTOGNOSIS_CONFIG=autognosis.json
AUTOGNOSIS_REMEMBER=0
# --- Deep Tree Echo chat engine (app/services/dte-chat.server.ts) ---
# Providers are tried in this order; the first healthy one answers.
DTE_LLM_PROVIDERS=ollama,openai,anthropic
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# OPENAI_API_KEY above also enables the openai provider
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
DTE_LLM_TIMEOUT_MS=30000
DTE_MAX_HISTORY=20
